// Endpoint for resend order notification
add_action('rest_api_init', function () {
    register_rest_route('custom/v1', '/orders/(?P<id>\d+)/resend', array(
        'methods' => 'POST',
        'callback' => 'custom_resend_new_order_notification',
        'permission_callback' => '__return_true',
    ));
});
function custom_resend_new_order_notification($data) {
    if (!function_exists('wc_get_order')) {
        if (file_exists(WP_PLUGIN_DIR . '/woocommerce/woocommerce.php')) {
            include_once WP_PLUGIN_DIR . '/woocommerce/woocommerce.php';
        }
        if (!function_exists('wc_get_order')) {
            return new WP_Error('no_wc', 'WooCommerce still not loaded', array('status' => 500));
        }
    }
    $order_id = (int) $data['id'];
    $order = wc_get_order($order_id);
    if (!$order) {
        return new WP_Error('no_order', 'Order not found', array('status' => 404));
    }
    $email = WC()->mailer()->get_emails()['WC_Email_New_Order'];
    if ($email) {
        $order = wc_get_order($order_id);
        $recipient = $email->get_recipient();
        $subject = 'Resended notification for order: #' . $order_id;
        $template_base = plugin_dir_path(WC_PLUGIN_FILE) . 'templates/';
        $template_path = $template_base . $email->template_html;
        if (file_exists($template_path)) {
            ob_start();
            include $template_path;
            $message = ob_get_clean();
        }
        $headers = array('Content-Type: text/html; charset=UTF-8');
        $attachments = array();
        $email->send($recipient, $subject, $message, $headers, $attachments);
    }
    return array(
        'success' => true,
        'message' => "Notification re-sent for order #$order_id"
    );
}
